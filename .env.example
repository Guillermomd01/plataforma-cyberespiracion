# Base de datos (Neon). En Netlify: Site configuration → Environment variables.
DATABASE_URL=
# URL pública de la plataforma, sin barra final. Ej.: https://plataforma.cyberespiracion.com
BETTER_AUTH_URL=
# Cadena aleatoria larga (openssl rand -base64 32). No cambiarla: cierra todas las sesiones.
BETTER_AUTH_SECRET=
# Brevo (emails). Clave de API transaccional.
BREVO_API_KEY=
EMAIL_FROM=hola@cyberespiracion.com
# Bunny CDN (audios y PDF)
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=
